# Execute python configurar.py. Não versione o .env.
API_BASE_URL=
API_TOKEN=
# Preferido: cliente OAuth; o aplicativo renova o token automaticamente.
ORDS_CLIENT_ID=
ORDS_CLIENT_SECRET=
SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
FLASK_ENV=development
# Ativar somente depois de validar os campos e a persistência na API.
ORDS_CESTAS_HABILITADAS=false
ORDS_SERVICOS_HABILITADOS=false
ORDS_DADOS_MEDICOS_HABILITADOS=false
# Em outra base, aplicar a migração e configurar a API protegida antes de habilitar.
